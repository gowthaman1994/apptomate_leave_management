API_CORS_ORIGINS=["http://localhost:5173"]
API_DATABASE_URL=postgresql+psycopg://app_user:<password>@localhost:5432/leave_management

# No default is provided for any of the three below (none would be safe) — the app
# fails to start if they are unset. JWT_SECRET_KEY: any long random string, used to
# sign/verify access and refresh tokens. PAYLOAD_ENCRYPTION_KEY: a Fernet key — 32
# random bytes, base64-encoded (generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
# — this key is also compiled into the frontend build (see spec.md's resolved
# clarification); it is obfuscation on top of HTTPS, not an independent secret.
API_JWT_SECRET_KEY=<long-random-string>
API_JWT_TOKEN_MINUTES=15
API_PAYLOAD_ENCRYPTION_KEY=<fernet-key-32-bytes-base64>

# Sign-in brute-force lockout (not secrets — safe to default, override per environment).
API_MAX_FAILED_LOGIN_ATTEMPTS=5
API_LOCKOUT_MINUTES=15
