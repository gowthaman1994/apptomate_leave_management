# No default is provided (none would be safe) — this must be the exact same Fernet key
# as the backend's API_PAYLOAD_ENCRYPTION_KEY (apps/api/.env.example), base64url, 32
# random bytes. This key is compiled into the frontend build; see
# specs/001-user-login-auth/spec.md's resolved clarification and
# specs/002-frontend-login-flow/research.md §5 — it is obfuscation on top of HTTPS,
# not an independent secret.
VITE_PAYLOAD_ENCRYPTION_KEY=<fernet-key-32-bytes-base64, same value as the backend's>
