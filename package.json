{
  "name": "apptomate-leave-management",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "concurrently -n web,api -c blue,green \"pnpm:dev:web\" \"pnpm:dev:api\"",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test && pnpm test:api",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "cd apps/api && .venv/bin/uvicorn app.main:app --reload --port 8000",
    "test:api": "cd apps/api && .venv/bin/pytest tests"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "concurrently": "^9.1.0"
  }
}
